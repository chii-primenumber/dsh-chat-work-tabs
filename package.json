{
  "name": "@local/dsh-chat-work-tabs",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Chat/Work entries, a web-endpoint chat page with history and attachments, \u2014 all in one bundle",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/pow.js",
    "lib/api.js",
    "lib/adapter.js",
    "lib/history.js",
    "lib/bridge.js",
    "lib/sha3_wasm_bg.wasm",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation", "@deepseek-ai/dsh-client-ui-sidebar"]
    }
  }
}
